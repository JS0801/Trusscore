<?xml version="1.0"?><!DOCTYPE pdf PUBLIC "-//big.faceless.org//report" "report-1.1.dtd">
<pdf>
<head>
	<link name="NotoSans" type="font" subtype="truetype" src="${nsfont.NotoSans_Regular}" src-bold="${nsfont.NotoSans_Bold}" src-italic="${nsfont.NotoSans_Italic}" src-bolditalic="${nsfont.NotoSans_BoldItalic}" bytes="2" />
	<#if .locale == "zh_CN">
		<link name="NotoSansCJKsc" type="font" subtype="opentype" src="${nsfont.NotoSansCJKsc_Regular}" src-bold="${nsfont.NotoSansCJKsc_Bold}" bytes="2" />
	<#elseif .locale == "zh_TW">
		<link name="NotoSansCJKtc" type="font" subtype="opentype" src="${nsfont.NotoSansCJKtc_Regular}" src-bold="${nsfont.NotoSansCJKtc_Bold}" bytes="2" />
	<#elseif .locale == "ja_JP">
		<link name="NotoSansCJKjp" type="font" subtype="opentype" src="${nsfont.NotoSansCJKjp_Regular}" src-bold="${nsfont.NotoSansCJKjp_Bold}" bytes="2" />
	<#elseif .locale == "ko_KR">
		<link name="NotoSansCJKkr" type="font" subtype="opentype" src="${nsfont.NotoSansCJKkr_Regular}" src-bold="${nsfont.NotoSansCJKkr_Bold}" bytes="2" />
	<#elseif .locale == "th_TH">
		<link name="NotoSansThai" type="font" subtype="opentype" src="${nsfont.NotoSansThai_Regular}" src-bold="${nsfont.NotoSansThai_Bold}" bytes="2" />
	</#if>
    <macrolist>
        <macro id="nlheader">
            <table class="header" style="width: 100%;"><tr>
			<td rowspan="3" style="width: 346px;"><img height="75px" src="https://6518122.app.netsuite.com/core/media/media.nl?id=6122&amp;c=6518122&amp;h=m6_0Vrb_g_AphBfET8BOfpOVIeIbop4Sotx3jZo2T1ewbnzh" style="float: left; margin: 7px" width="215px" /></td>
			<td align="right"><span style="font-family:Times New Roman,Times,serif;"><span style="font-size:20px;"><b>LOAD CONFIRMATION</b></span></span></td>
		</tr>
		<tr>
			<td align="right" style="width: 458px;"><span style="font-size:12px;"><span class="number"><b>Confirmation #:</b> ${record.tranid}</span></span></td>
		</tr>
        <tr>
			<td align="right" style="width: 458px;"><span style="font-size:10px;"><span class="number"><b>Sales Orders #:</b> ${record.custbody_tc_related_so}</span></span></td>
		</tr>
            </table>
<br />
<br />
<br />
<br />
<br />
&nbsp;
        </macro>
        <macro id="nlfooter">
            <table class="footer" style="width: 100%;"><tr>
			<td><barcode codetype="code128" showtext="true" value="${record.tranid}"/></td>
			<td align="right"><pagenumber/> of <totalpages/></td>
		</tr></table>
        </macro>
    </macrolist>
    <style type="text/css">* {
		<#if .locale == "zh_CN">
			font-family: NotoSans, NotoSansCJKsc, sans-serif;
		<#elseif .locale == "zh_TW">
			font-family: NotoSans, NotoSansCJKtc, sans-serif;
		<#elseif .locale == "ja_JP">
			font-family: NotoSans, NotoSansCJKjp, sans-serif;
		<#elseif .locale == "ko_KR">
			font-family: NotoSans, NotoSansCJKkr, sans-serif;
		<#elseif .locale == "th_TH">
			font-family: NotoSans, NotoSansThai, sans-serif;
		<#else>
			font-family: NotoSans, sans-serif;
		</#if>
		}
		table {
			font-size: 9pt;
			table-layout: fixed;
		}
        th {
            font-weight: bold;
            font-size: 8pt;
            vertical-align: middle;
            padding: 5px 6px 3px;
            background-color: #e3e3e3;
            color: #333333;
        }
        td {
            padding: 4px 6px;
        }
		td p { align:left }
        b {
            font-weight: bold;
            color: #333333;
        }
        table.header td {
            padding: 0;
            font-size: 10pt;
        }
        table.footer td {
            padding: 0;
            font-size: 8pt;
        }
        table.itemtable th {
            padding-bottom: 10px;
            padding-top: 10px;
        }
        table.body td {
            padding-top: 2px;
        }
        table.total {
            page-break-inside: avoid;
        }
        tr.totalrow {
            background-color: #e3e3e3;
            line-height: 200%;
        }
        td.totalboxtop {
            font-size: 12pt;
            background-color: #e3e3e3;
        }
        td.addressheader {
            font-size: 8pt;
            padding-top: 6px;
            padding-bottom: 2px;
        }
        td.address {
            padding-top: 0;
        }
        td.totalboxmid {
            font-size: 28pt;
            padding-top: 20px;
            background-color: #e3e3e3;
        }
        td.totalboxbot {
            background-color: #e3e3e3;
            font-weight: bold;
        }
        span.title {
            font-size: 28pt;
        }
        span.number {
            font-size: 16pt;
        }
        span.itemname {
            font-weight: bold;
            line-height: 150%;
        }
        hr {
            width: 100%;
            color: #d3d3d3;
            background-color: #d3d3d3;
            height: 1px;
        }
</style>
</head>
<body header="nlheader" header-height="10%" footer="nlfooter" footer-height="20pt" padding="0.5in 0.5in 0.5in 0.5in" size="Letter">
    <table style="width: 100%; font-family:Times New Roman,Times,serif;">
      	 <tr>
			<td align="right" width="25%"><b>Bill To Name: </b></td>
      		<td align="left" width="35%"><#if record.custbody_tc_shipping_loc == "Palmerston - Main">Trusscore Inc.<#else>Trusscore Alberta Inc.</#if></td>
      		<td align="right" width="35%"><b>Date: </b></td>
      		<td align="left" width="15%">${record.trandate}</td>
		 </tr>
      	 <tr>
			<td align="right" width="25%"><b>Contact Person: </b></td>
      		<td align="left" width="35%">${record.custbody_tc_load_owner}</td>
      		<td align="right" width="35%"><b>Cost: </b></td>
      		<td align="left" width="15%"><#if record.custbodycustbody_vendor_fr_currency == "Canadian Dollar">CAD&nbsp;</#if> <#if record.custbodycustbody_vendor_fr_currency == "US Dollar"> USD&nbsp;</#if> <#if record.custbody_ts_vendor_freight gt 0>${record.custbody_ts_vendor_freight}<#else>0</#if></td>
		 </tr>
      	 <tr>
			<td align="right" width="25%"><b>Contact Person Email: </b></td>
      		<td align="left" width="35%">${record.custbody_tc_load_contact_email}</td>
		 </tr>
          <tr>
			<td align="right" width="25%"><b>Contact Person Phone: </b></td>
      		<td align="left" width="35%">${record.custbody_tc_load_contact_number} <#if record.custbody_tc_load_owner.custentity_tc_voip_ext?has_content>Ext: ${record.custbody_tc_load_owner.custentity_tc_voip_ext}</#if></td>
		 </tr>
    </table>

&nbsp;

<table style="width: 100%; border: 1px solid black;"><tr>
			<td align="center" style="background-color: rgb(170, 170, 170);"><span style="font-family:Times New Roman,Times,serif;"><span style="font-size:20px;"><b>Loading Information</b></span></span></td>
		</tr></table>

<table style="width: 100%; border: 1px solid black; font-family:Times New Roman,Times,serif;">
  	<tr padding-top="7px">
      <td align="right" width="25%" style="font-size:11px;"><b>Requested Load Date: </b></td>
      <td align="left" width="25%" style="font-size:11px;">${record.custbody_tc_req_load_date}</td>
      <td align="right" width="25%" style="font-size:11px;"><b>Load At Name: </b></td>
      <td align="left" width="25%" style="font-size:11px;"><#if record.custbody_tc_shipping_loc == "Palmerston - Main">Trusscore Inc.<#else>Trusscore Alberta Inc.</#if></td>
	</tr>
  	<tr>
      <td align="right" width="25%" style="font-size:11px;"><b>Requested Equipment Type: </b></td>
      <td align="left" width="25%" style="font-size:11px;">${record.custbody_tc_req_equi_type}</td>
      <td align="right" width="25%" style="font-size:11px;"><b>Weight: </b></td>
      <td align="left" width="25%" style="font-size:11px;"><#if record.custbody_ds_final_cal_weight?has_content>${record.custbody_ds_final_cal_weight?floor} LB<#else>0 LB</#if></td>
	</tr>
  	<tr>
      <td align="right" width="25%" style="font-size:11px;"><b>Load At Contact Name: </b></td>
      <td align="left" width="25%" style="font-size:11px;">${record.custbody_tc_load_contact_name}</td>      
      <td align="right" width="25%" style="font-size:11px;"><b>Loading Appt time: </b></td>
      <td align="left" width="25%" style="font-size:11px;">${record.custbody_tc_loading_hrs}</td>
	</tr>
  	<tr>
      <td align="right" width="25%"></td>
      <td align="right" width="25%"></td>
      <td align="right" width="25%" style="font-size:11px;"><b>Appt Necessary (yes or no)?: </b></td>
      <td align="left" width="25%" style="font-size:11px;">Yes</td>
	</tr>
  	<tr>
      <td align="right" width="25%"></td>
      <td align="right" width="25%"></td>
      <td align="right" width="25%" style="font-size:11px;"><b>Appt time: </b></td>
      <td align="left" width="25%" style="font-size:11px;"></td>
	</tr>
  	<tr>
      <td align="right" width="25%" style="font-size:11px;"><b>Load at Address: </b></td>
      <td align="left" width="75%" colspan="3" style="font-size:11px;">${record.custbody_tc_ship_loc_addr1}<#if record.custbody_tc_ship_loc_addr2?has_content>${record.custbody_tc_ship_loc_addr2}</#if>, ${record.custbody_tc_ship_loc_city}, ${record.custbody_tc_ship_loc_province}&nbsp;${record.custbody_tc_ship_loc_zipcode}&nbsp;${record.custbody_tc_ship_loc_country}</td>
	</tr>
  	<tr>
      <td align="right" width="25%" style="font-size:11px;"><b>Other Information: </b></td>
      <td align="left" width="75%" colspan="3" style="font-size:11px;">${record.memo}</td>
	</tr>
  	<tr padding-bottom="7px">
	<#if record.custbody_ds_freight_purchase_order?? && record.custbody_ds_freight_purchase_order?has_content>
     <td align="right" width="25%" style="font-size:11px;"><b>PO Number: </b></td>
      <td align="left" width="75%" colspan="3" style="font-size:11px;">${record.custbody_ds_freight_purchase_order}</td>
	<#else>
		<td align="right" width="25%" style="font-size:11px;"><b>PO Account: </b></td>
      <td align="left" width="75%" colspan="3" style="font-size:11px;">${record.custbody_tc_po_account}</td>
	</#if>
	</tr>
  </table>

<table style="width: 100%; border: 1px solid black;"><tr>
			<td align="center" style="background-color: rgb(170, 170, 170);"><span style="font-family:Times New Roman,Times,serif;"><span style="font-size:20px;"><b>Delivery Information</b></span></span></td>
		</tr></table>

<table style="width: 100%; border: 1px solid black;">
  <tr padding-top="7px">
    <td align="right" width="25%" style="font-size:11px;"><b>Delivery Name: </b></td>
    <td align="left" width="25%" style="font-size:11px;">${record.custbody_tc_delivery_name}</td>
    <td align="right" width="25%" style="font-size:11px;"><b>Expected Delivery Date: </b></td>
    <td align="left" width="25%" style="font-size:11px;">${record.custbody_tc_exp_delivery_date}</td>
  </tr>
  <tr>
    <td align="right" width="25%" style="font-size:11px;"><b>Delivery Address: </b></td>
    <td align="left" width="75%" colspan="3" style="font-size:11px;">${record.custbody_tc_shipping_address}</td>
  </tr>
  <tr>
    <td align="right" width="25%" style="font-size:11px;"><b>Other Delivery Information: </b></td>
    <td align="left" width="75%" colspan="3" style="font-size:11px;"></td>
  </tr>
  <tr>
    <td align="right" width="25%" style="font-size:11px;"><b>Other Information: </b></td>
    <td align="left" width="75%" colspan="3" style="font-size:11px;">${record.custbody_tc_other_information}</td>
  </tr>
  <tr>
    <td align="right" width="25%" style="font-size:11px;"><b>Appt Necessary(yes or no)?: </b></td>
    <td align="left" width="25%" style="font-size:11px;">Yes</td>
  </tr>
  <tr padding-bottom="7px">
    <td align="right" width="25%" style="font-size:11px;"><b>Receiver Contact: </b></td>
    <td align="left" width="25%" style="font-size:11px;">${record.custbody_tc_receiver_contact_name}<br/>${record.custbody_tc_receiver_number}</td>
    <td align="right" width="25%" style="font-size:11px;"><b>Customer PO's: </b></td>
    <td align="left" width="25%" style="font-size:11px;">${record.custbody_tc_other_deliver_information}</td>
  </tr>
</table>

<table style="width: 100%; border: 1px solid black;">
  <tr>
    <td align="center" style="background-color: rgb(170, 170, 170);"><span style="font-family:Times New Roman,Times,serif;"><span style="font-size:20px;"><b>Additional Services Requested</b></span></span></td>
  </tr>
</table>

<table style="width: 100%; border: 1px solid black;">
  <tr padding-top="7px">
    <td align="right" width="25%" style="font-size:11px;"><b>Proof-of-delivery (yes or no): </b></td>
    <td align="left" width="20%" style="font-size:11px;">Yes</td>
  </tr>
  <tr>
    <td align="right" width="25%" style="font-size:11px;"><b>Tarped Load (yes or no): </b></td>
    <td align="left" width="20%" style="font-size:11px;">${record.custbody_tarped_load}</td>
  </tr>
  <tr padding-bottom="7px">
    <td align="right" width="25%" style="font-size:11px;"><b>Other (please specify): </b></td>
    <td align="left" width="75%" colspan="3" style="font-size:11px;">BOL Must be signed and dated by Shipper, Carrier, and Receiver.<br/>BOL must be submitted with the invoice.</td>
  </tr>
</table>
</body>
</pdf>